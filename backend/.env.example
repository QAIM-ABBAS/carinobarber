# The configuration of the whole stack lives in the .env of the repository root
# (next to docker-compose.yml) — see ../.env.example.
#
# This file is only a reference of the variables the backend reads. Copy it to
# "backend/.env" when you want to override single values for a local run; the
# backend reads the root .env first and this file afterwards, so it wins.
#
# Example (a local backend against the database published by docker compose):
#
# DATABASE_URL=postgresql+psycopg://gc:gc@localhost:5433/gentlemans_club

APP_ENV=development
DATABASE_URL=postgresql+psycopg://gc:gc@db:5432/gentlemans_club
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
SHOP_TIMEZONE=Asia/Tehran
SEED_ON_START=true
SMS_PROVIDER=console
RATE_LIMIT_BOOKINGS_PER_MINUTE=5
