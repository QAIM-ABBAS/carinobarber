# ---------------------------------------------------------------------------
# Shared configuration of the stack (backend + docker compose + vite dev).
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------------------

# --- host ports of the stack -------------------------------------------------
# The port the frontend is published on (the only service that is exposed).
FRONTEND_PORT=8081
# The port of the API — only used by docker-compose.dev.yml (local development).
API_PORT=8080

# --- backend ------------------------------------------------------------------
APP_ENV=development
# Inside docker compose the database is reachable under the service name "db".
DATABASE_URL=postgresql+psycopg://gc:gc@db:5432/gentlemans_club
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_DAYS=30
OTP_DEV_MODE=true
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# The verified customer phone that may open the admin panel without the password
# (e.g. 09121234567). Leave empty to keep only the username/password login.
ADMIN_PHONE=09121234567
# The origin of the vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
SHOP_TIMEZONE=Asia/Tehran
SEED_ON_START=true
SMS_PROVIDER=console
RATE_LIMIT_BOOKINGS_PER_MINUTE=5

# --- frontend (vite dev server) -----------------------------------------------
# Leave it empty to use the relative path (the dev proxy forwards /api).
VITE_API_URL=
# Target of the vite dev proxy; empty means "use API_PORT".
API_PROXY_TARGET=
