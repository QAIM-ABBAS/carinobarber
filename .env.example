# ---------------------------------------------------------------------------
# Shared configuration of the stack (backend + docker compose + vite dev).
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------------------

# --- host ports of the stack -------------------------------------------------
# The port the API is published on (the container always listens on 8000).
API_PORT=8080
# The port the frontend (nginx) is published on (the container listens on 80).
FRONTEND_PORT=8081

# --- backend ------------------------------------------------------------------
APP_ENV=development
# Inside docker compose the database is reachable under the service name "db".
DATABASE_URL=postgresql+psycopg://gc:gc@db:5432/gentlemans_club
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# The origins of the vite dev server and of the nginx frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
SHOP_TIMEZONE=Asia/Tehran
SEED_ON_START=true
SMS_PROVIDER=console
RATE_LIMIT_BOOKINGS_PER_MINUTE=5

# --- frontend (vite dev server) -----------------------------------------------
# Leave it empty to use the relative path (the dev proxy forwards /api).
VITE_API_URL=
# Target of the vite dev proxy; empty means "use API_PORT".
API_PROXY_TARGET=
